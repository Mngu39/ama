#pragma once
#include "../core/move.h"
#include "../core/chain.h"
#include <array>
#include <algorithm>
#include <stdexcept>
#include <string>
#include <vector>

#include <random>
class PuyoEnv {
public:
    static constexpr int ACTION_COUNT = 22;
    static constexpr int MAX_TURNS = 50;

    struct Observation {
        // board[0] is the bottom row
        std::array<std::array<char, 6>, 13> board{};
        u8 row14 = 0;
        std::array<cell::Pair, 3> visible{};
        int turn = 0;
    };
    struct Result {
        Observation observation;
        int chains = 0;
        int score = 0;
        bool terminated = false;
        bool truncated = false;
    };

    Observation reset(u32 seed) {
        field_ = Field();
        queue_ = cell::create_queue(seed);
        turn_ = 0;
        done_ = false;
        return observation();
    }
    Observation observation() {
        Observation obs;
        for (int y = 0; y < 13; ++y) {
            for (int x = 0; x < 6; ++x) {
                obs.board[y][x] = cell::to_char(
                    field_.get_cell(x, y)
                );
            }
        }

        obs.row14 = field_.row14;
        for (int i = 0; i < 3; ++i) {
            obs.visible[i] = queue_.at(turn_ + i);
        }
        obs.turn = turn_;
        return obs;
    }
    std::array<bool, ACTION_COUNT> legal_actions() {
        std::array<bool, ACTION_COUNT> mask{};
        if (done_ || turn_ >= MAX_TURNS) return mask;

        auto pair = queue_.at(turn_);
        auto moves = move::generate(
            field_, pair.first == pair.second
        );

        for (int i = 0; i < moves.get_size(); ++i) {
            mask[encode_action(moves[i])] = true;
        }
        return mask;
    }
    Result step(int action_id) {
        if (done_) {
            throw std::logic_error("Episode already ended");
        }

        auto mask = legal_actions();
        if (action_id < 0 || action_id >= ACTION_COUNT
            || !mask[action_id]) {
            throw std::invalid_argument("Illegal action");
        }

        auto placement = decode_action(action_id);
        field_.drop_pair(
            placement.x, placement.r, queue_.at(turn_)
        );
        auto popped = field_.pop();
        auto outcome = chain::get_score(popped);
        ++turn_;

        bool truncated = (turn_ >= MAX_TURNS);
        bool terminated = false;

        if (!truncated) {
            auto next_mask = legal_actions();
            terminated = std::none_of(
                next_mask.begin(), next_mask.end(),
                [](bool legal) { return legal; }
            );
        }
        done_ = terminated || truncated;
        return {
            observation(),
            outcome.count,
            outcome.score,
            terminated,
            truncated
        };
    }

    // Simulate one legal action without changing the real environment.
    // The copy owns a separate field, queue and turn counter.
    Result preview(int action_id) const {
        PuyoEnv simulated = *this;
        return simulated.step(action_id);
    }

    PuyoEnv fork_with_hidden_pairs(const std::vector<std::string>& pairs) const {
        if (pairs.size() != queue_.size())
            throw std::invalid_argument("Expected a complete 128-pair queue");

        PuyoEnv fork = *this;

        auto color = [](char c) -> cell::Type {
            if (c != 'R' && c != 'Y' && c != 'G' && c != 'B')
                throw std::invalid_argument("Hidden colors must be R/Y/G/B");
            return cell::from_char(c);
        };

        for (size_t i = size_t(turn_ + 3); i < queue_.size(); ++i) {
            if (pairs[i].size() != 2)
                throw std::invalid_argument("Every pair must have two colors");

            fork.queue_[i] = {
                color(pairs[i][0]),
                color(pairs[i][1])
            };
        }

        return fork;
    }

    // Draw an independent Ama queue conditioned on the CURRENT/NEXT/NEXT2
    // actually visible at this decision point. No hidden original queue pair
    // is copied or inspected. Rejection is over *seeds*, not queue fragments:
    // every accepted full queue is generated by cell::create_queue(seed).
    //
    // This is exact for P(queue suffix | three visible pairs) under a uniform
    // 32-bit seed prior. It does NOT condition on the entire past queue history.
    // Throw rather than silently fall back to the old incorrect splice if a
    // sufficiently rare visible triple exceeds the trial budget.
    PuyoEnv fork_with_hidden_rule_seed(u32 fresh_seed) const {
        if (queue_.size() < size_t(turn_ + 3))
            throw std::logic_error("Not enough visible pairs for conditional fork");
        std::mt19937 candidate_rng(fresh_seed);
        constexpr u32 MAX_ATTEMPTS = 2'000'000;
        for (u32 trial = 0; trial < MAX_ATTEMPTS; ++trial) {
            const auto sampled_seed = static_cast<u32>(candidate_rng());
            auto alternative = cell::create_queue(sampled_seed);
            bool matches = true;
            for (int k = 0; k < 3; ++k) {
                if (alternative[size_t(turn_ + k)] != queue_[size_t(turn_ + k)]) {
                    matches = false;
                    break;
                }
            }
            if (!matches) continue;
            PuyoEnv fork = *this;
            for (size_t i = size_t(turn_ + 3); i < queue_.size(); ++i)
                fork.queue_[i] = alternative[i];
            return fork;
        }
        throw std::runtime_error(
            "Ama rule_based conditional seed sampling exceeded 2000000 trials; "
            "no approximate or oracle fallback was used");
    }
    bool done() const { return done_; }

private:
    Field field_;
    cell::Queue queue_;
    int turn_ = 0;
    bool done_ = false;
    static int encode_action(move::Placement p) {
        switch (p.r) {
        case direction::Type::UP:    return p.x;
        case direction::Type::RIGHT: return 6 + p.x;
        case direction::Type::DOWN:  return 11 + p.x;
        case direction::Type::LEFT:  return 16 + p.x;
        }
        throw std::invalid_argument("Invalid rotation");
    }
    static move::Placement decode_action(int id) {
        if (id < 6)
            return {static_cast<i8>(id), direction::Type::UP};
        if (id < 11)
            return {static_cast<i8>(id - 6), direction::Type::RIGHT};
        if (id < 17)
            return {static_cast<i8>(id - 11), direction::Type::DOWN};
        return {static_cast<i8>(id - 16), direction::Type::LEFT};
    }
};
